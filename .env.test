DATABASE_URL="postgresql://judge_arena:password@localhost:5432/judge_arena_test"
TEST_DATABASE_URL="postgresql://judge_arena:password@localhost:5432/judge_arena_test"

# Redis — used by tests/integration/** (npm run test:integration) against
# the podman container `judge-arena-redis` (redis:7-alpine, --maxmemory-policy
# noeviction) already running on the default port.
REDIS_URL="redis://localhost:6379"

# RabbitMQ — used by tests/integration/queue.test.ts against the podman
# container `judge-arena-rabbitmq` (rabbitmq:3.13-management-alpine) already
# running on the default port (5672; management UI on 15672).
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# v1 scratch DB for the importer's DB-backed tests (tests/importer/**/*.db.test.ts)
# — see prisma/v1/schema.v1.prisma and scripts/importer/context.ts. Schema is
# laid on with `V1_DATABASE_URL=... npx prisma db push --schema prisma/v1/schema.v1.prisma
# --skip-generate` (one-time, not part of `prisma migrate reset`, which only
# touches the v2 schema/DATABASE_URL above).
V1_DATABASE_URL="postgresql://judge_arena:password@localhost:5432/judge_arena_v1"
