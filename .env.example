# Judge Arena - LLM-as-a-Judge Data Labelling Studio
# Copy this file to .env.local and fill in your values

# ─── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
# If password contains special characters (e.g. @, :, /), URL-encode them.
DATABASE_URL="postgresql://judge_arena:password@localhost:5432/judge_arena"

# ─── Authentication ─────────────────────────────────────────────────────────────
# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Authentik OIDC (1b Task 13) ─────────────────────────────────────────────────
# Accounts are invite-only — self-service registration (/api/auth/register) is
# retired. Authentik OIDC is the primary sign-in path; the credentials
# provider stays only for admin-created accounts (scripts/admin/create-user.ts
# --password=...). See docs/runbooks/authentik-oidc-setup.md for the full
# provider/application blueprint, including the grant_types gotcha and the
# invite-claim flow.
#
# The base issuer URL of your Authentik application (NOT the well-known
# discovery URL — that's derived from this: `${AUTHENTIK_ISSUER}/.well-known/
# openid-configuration`). This exact string is also the (oidcIssuer, ...)
# half of every OIDC user's identity key in our schema — changing it after
# go-live orphans existing OIDC users (their oidcIssuer no longer matches),
# so treat it as stable configuration, not a value to casually edit.
# AUTHENTIK_ISSUER=https://authentik.lab.example/application/o/judge-arena
# AUTHENTIK_CLIENT_ID=
# AUTHENTIK_CLIENT_SECRET=
#
# Self-service OIDC sign-in for an identity resolveOidcUser has never seen
# before (no existing (issuer, sub) match, no invitePending row claiming
# its email) is DENIED by default — invite-only means invite-only, not
# "anyone who can reach the login page". Authentik's own group membership
# on the application is the real access gate (see the runbook); this flag
# is an escape hatch for deployments that instead want any authenticated
# Authentik user to get an account automatically. Leave unset/false unless
# you specifically want that.
# ALLOW_OIDC_AUTOPROVISION=false

# ─── Encryption ─────────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting API keys at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── LLM Provider API Keys ─────────────────────────────────────────────────────
# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=

# OpenRouter — NOT read as an env-var credential fallback (kind:
# "openai_compatible" descriptors never get one, see resolveApiKey() in
# src/lib/llm/registry.ts); this is guidance for what to paste into the
# ModelEndpoint's own key field when configuring an OpenRouter model.
# OPENROUTER_API_KEY=
# Attribution header (HTTP-Referer) sent with every OpenRouter request —
# falls back to NEXTAUTH_URL above if unset (see
# src/lib/llm/backends/openrouter.ts).
# OPENROUTER_SITE_URL=

# vLLM (self-hosted, OpenAI-compatible) — default base URL, read fresh on
# every call (src/lib/llm/registry.ts's getDescriptor()). A ModelEndpoint's
# own endpoint URL, if set, always overrides this.
# VLLM_BASE_URL=http://localhost:8000/v1
# Like OPENROUTER_API_KEY above: guidance only, never an env-var credential
# fallback — configure the ModelEndpoint's own key field instead.
# VLLM_API_KEY=

# Local Model Endpoint (e.g., Ollama, vLLM, llama.cpp)
# LOCAL_MODEL_ENDPOINT=http://localhost:11434/v1

# ─── Redis ──────────────────────────────────────────────────────────────────────
# Backs the Lua sliding-window rate limiter (shared budget across replicas —
# see requireAuth() in src/lib/auth-guard.ts) and, optionally, the SSE
# realtime adapter below.
# Required in production: getRedis() throws at first use if unset with
# NODE_ENV=production. Non-production environments default to
# redis://localhost:6379 if unset, so this is optional for local dev — but
# rate limiting/health checks obviously need a real Redis running to exercise.
REDIS_URL=redis://localhost:6379

# ─── RabbitMQ ───────────────────────────────────────────────────────────────────
# Backs the judgment-execution and run-create queues (src/lib/queue/**) —
# see connection.ts for the connect/reconnect contract and topology.ts for
# the exchange/queue layout.
# Required in production: getRabbit() throws at first use if unset with
# NODE_ENV=production. Non-production environments default to
# amqp://guest:guest@localhost:5672 if unset — but the queue integration
# tests obviously need a real RabbitMQ running to exercise.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ─── Realtime / SSE ────────────────────────────────────────────────────────────
# No separate config — the realtime bus shares REDIS_URL above (in-memory
# only under NODE_ENV=test; see src/lib/realtime/factory.ts).

# ─── Evaluation Engine ─────────────────────────────────────────────────────────
# EVALUATION_RUN_QUEUE_CONCURRENCY=4
# EVALUATION_MODEL_CONCURRENCY_PER_RUN=2
# EVALUATION_MODEL_TIMEOUT_MS=120000

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# All limiters are Redis-backed (see REDIS_URL above) and share one budget
# across every replica. Override default limits (requests per minute) — var
# names must match exactly, including the _MAX suffix:
# RATE_LIMIT_ENABLED=true          # set "false" to disable rate limiting entirely
# RATE_LIMIT_AUTH_MAX=5            # login/registration endpoints
# RATE_LIMIT_API_MAX=120           # general authenticated API (requireAuth() chokepoint)
# RATE_LIMIT_JUDGE_MAX=10          # evaluation run launches
# RATE_LIMIT_HUGGINGFACE_MAX=30    # HuggingFace dataset preview/rows

# ─── Logging ────────────────────────────────────────────────────────────────────
# LOG_LEVEL=info             # debug | info | warn | error | fatal

# ─── Proxy / Deployment ────────────────────────────────────────────────────────
# Set to "true" when behind a reverse proxy (Railway, Vercel, etc.)
# Required for correct client IP detection in rate limiting.
# TRUSTED_PROXY=true

# Railway injects this automatically — used in CSP connect-src
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app

# ─── Seed Data ─────────────────────────────────────────────────────────────────
# Override default seed passwords for production deployments
# SEED_ADMIN_PASSWORD=changeme
# SEED_DEMO_PASSWORD=changeme

# ─── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Judge Arena"
NODE_ENV=development
