# Judge Arena - LLM-as-a-Judge Data Labelling Studio
# Copy this file to .env.local and fill in your values

# ─── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
# If password contains special characters (e.g. @, :, /), URL-encode them.
DATABASE_URL="postgresql://judge_arena:password@localhost:5432/judge_arena"

# ─── Authentication ─────────────────────────────────────────────────────────────
# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Encryption ─────────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting API keys at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── LLM Provider API Keys ─────────────────────────────────────────────────────
# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=

# Local Model Endpoint (e.g., Ollama, vLLM, llama.cpp)
# LOCAL_MODEL_ENDPOINT=http://localhost:11434/v1

# ─── Redis ──────────────────────────────────────────────────────────────────────
# Backs the Lua sliding-window rate limiter (shared budget across replicas —
# see requireAuth() in src/lib/auth-guard.ts) and, optionally, the SSE
# realtime adapter below.
# Required in production: getRedis() throws at first use if unset with
# NODE_ENV=production. Non-production environments default to
# redis://localhost:6379 if unset, so this is optional for local dev — but
# rate limiting/health checks obviously need a real Redis running to exercise.
REDIS_URL=redis://localhost:6379

# ─── Realtime / SSE ────────────────────────────────────────────────────────────
# No separate config — the realtime bus shares REDIS_URL above (in-memory
# only under NODE_ENV=test; see src/lib/realtime/factory.ts).

# ─── Evaluation Engine ─────────────────────────────────────────────────────────
# EVALUATION_RUN_QUEUE_CONCURRENCY=4
# EVALUATION_MODEL_CONCURRENCY_PER_RUN=2
# EVALUATION_MODEL_TIMEOUT_MS=120000

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# All limiters are Redis-backed (see REDIS_URL above) and share one budget
# across every replica. Override default limits (requests per minute) — var
# names must match exactly, including the _MAX suffix:
# RATE_LIMIT_ENABLED=true          # set "false" to disable rate limiting entirely
# RATE_LIMIT_AUTH_MAX=5            # login/registration endpoints
# RATE_LIMIT_API_MAX=120           # general authenticated API (requireAuth() chokepoint)
# RATE_LIMIT_JUDGE_MAX=10          # evaluation run launches
# RATE_LIMIT_HUGGINGFACE_MAX=30    # HuggingFace dataset preview/rows

# ─── Logging ────────────────────────────────────────────────────────────────────
# LOG_LEVEL=info             # debug | info | warn | error | fatal

# ─── Proxy / Deployment ────────────────────────────────────────────────────────
# Set to "true" when behind a reverse proxy (Railway, Vercel, etc.)
# Required for correct client IP detection in rate limiting.
# TRUSTED_PROXY=true

# Railway injects this automatically — used in CSP connect-src
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app

# ─── Seed Data ─────────────────────────────────────────────────────────────────
# Override default seed passwords for production deployments
# SEED_ADMIN_PASSWORD=changeme
# SEED_DEMO_PASSWORD=changeme

# ─── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Judge Arena"
NODE_ENV=development
