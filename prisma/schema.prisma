generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (v2) ─────────────────────────────────────────────────────────────
// Landed ahead of the model columns that will consume most of them (Tasks
// 3-5); only Visibility is used by a model in this task. Names are verbatim
// per the v2 architecture spec so later tasks reference stable identifiers.

enum JudgeClass {
  prompted_api
  prompted_open_weight
  finetuned_judge_lm
  sequence_classifier_rm
  generative_rm
  specialized_safety
  specialized_factuality
}

enum ScoringMechanism {
  reward_head_scalar
  token_probability
  critique_generative
}

enum ServingBackend {
  anthropic
  openai
  openrouter
  vllm
  ollama
  llamacpp
}

enum Quantization {
  none
  fp8
  int8
  int4
}

enum ReasoningMode {
  none
  optional
  always
}

enum TrustState {
  untrusted
  calibrating
  trusted
  rejected
}

enum RunProtocol {
  pointwise
  pairwise
  listwise
}

enum RunStatus {
  pending
  judging
  needs_human
  completed
  error
}

enum JudgmentStatus {
  pending
  running
  completed
  error
}

enum Visibility {
  private
  public
}

// ─── Auth ───────────────────────────────────────────────────────────────────

model User {
  id                String            @id @default(cuid())
  // NOT globally unique (see spec §7 non-destructive-v5 condition / the
  // "linking hazard" finding): OIDC identity is (oidcIssuer, oidcSubject)
  // ONLY. Two distinct Users MAY share an email — e.g. a rogue/second OIDC
  // identity presenting an email that collides with an existing account
  // must be able to resolve to its own distinct User row rather than being
  // silently linked to (or blocked by) the existing one. Indexed (not
  // unique) for lookup performance; credentials login and the invite-claim
  // path (src/lib/oidc-user.ts) both filter further (passwordHash shape /
  // invitePending) to disambiguate when more than one row shares an email.
  // A SEPARATE partial unique index (Prisma DSL can't express a WHERE
  // clause — see prisma/migrations/20260729180000_v2b_email_partial_unique
  // and CONTRIBUTING.md's "Known migrate-diff pseudo-drift" section) DOES
  // enforce "at most one real-credentials row per email" at the DB level;
  // it deliberately excludes OIDC/invite rows (sentinel `!`-prefixed
  // passwordHash), which remain free to share an email as described above.
  email             String
  name              String?
  passwordHash      String
  role              String            @default("user") // "user" | "admin"
  emailVerified     Boolean           @default(false)
  verificationToken String?           @unique
  resetToken        String?           @unique
  resetTokenExpiry  DateTime?
  oidcIssuer        String?
  oidcSubject       String?
  // Set by the admin invite CLI (scripts/admin/create-user.ts) for an
  // OIDC-pending invite: a User row created with a real email but no
  // oidcIssuer/oidcSubject yet. The ONE email-adjacent path in OIDC sign-in
  // (see src/lib/oidc-user.ts's resolveOidcUser) is gated strictly on
  // `invitePending: true` AND `oidcSubject: null` — it claims the invite
  // (stamps issuer/sub, flips this back to false) rather than doing general
  // email-based account linking. Never read anywhere else.
  invitePending     Boolean           @default(false)
  projects          Project[]
  rubrics           Rubric[]
  modelConfigs      ModelConfig[]
  evaluations       Evaluation[]
  evaluationRuns    EvaluationRun[]
  humanJudgments    HumanJudgment[]
  datasets          Dataset[]
  developerApiKeys  DeveloperApiKey[]
  auditLogs         AuditLog[]
  modelEndpoints    ModelEndpoint[]
  goldenSets        GoldenSet[]
  goldenLabels      GoldenLabel[]
  sampleRevisions   SampleRevision[]
  // A1: three separate back-relations because a User meets the annotation
  // workflow in three distinct roles — who edited an item, who was ASKED to
  // annotate, and who did the asking. All three are SetNull on delete.
  goldenItemRevisions    GoldenItemRevision[]
  assignedAnnotations    GoldenAssignment[]   @relation("AssignedAnnotator")
  coordinatedAssignments GoldenAssignment[]   @relation("AssigningCoordinator")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([oidcIssuer, oidcSubject])
  @@index([email])
}

// ─── Domain ─────────────────────────────────────────────────────────────────

model Project {
  id          String       @id @default(cuid())
  name        String
  slug        String? // portable identifier for config export/import
  description String?
  isDefault   Boolean      @default(false) // true for system-wide projects like Leaderboard
  visibility  Visibility   @default(private)
  publishedAt DateTime?
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluations Evaluation[]
  datasets    Dataset[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, slug])
  @@index([userId])
}

model Rubric {
  id             String            @id @default(cuid())
  name           String
  slug           String? // portable identifier for config export/import
  description    String?
  version        Int               @default(1)
  parentId       String? // null for v1; root rubric id for later versions
  parent         Rubric?           @relation("RubricVersions", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions       Rubric[]          @relation("RubricVersions")
  visibility     Visibility        @default(private)
  publishedAt    DateTime?
  retiredAt      DateTime?
  criteria       RubricCriterion[]
  evaluations    Evaluation[]
  evaluationRuns EvaluationRun[]
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([userId, slug])
  @@unique([parentId, version])
  @@index([parentId])
  @@index([userId])
  calibrationRuns CalibrationRun[]
}

model RubricCriterion {
  id          String @id @default(cuid())
  rubricId    String
  rubric      Rubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  name        String
  description String
  maxScore    Int    @default(10)
  weight      Float  @default(1.0)
  order       Int    @default(0)

  @@index([rubricId])
}

model ModelConfig {
  id                   String                     @id @default(cuid())
  name                 String
  slug                 String? // portable identifier for config export/import
  provider             String // 'anthropic' | 'openai' | 'local'
  modelId              String // e.g. 'claude-sonnet-4-5-20250514'
  endpoint             String? // custom endpoint for local/self-hosted models
  apiKey               String? // stored per-model (optional, falls back to env)
  isActive             Boolean                    @default(true)
  isVerified           Boolean                    @default(false)
  verifiedAt           DateTime?
  verificationError    String?
  userId               String
  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  judgments            ModelJudgment[]
  evaluationSelections EvaluationModelSelection[]
  runModelSelections   RunModelSelection[]
  bestModelSelections  HumanJudgment[]            @relation("BestModelSelection")

  @@unique([userId, slug])
  @@index([userId])
}

// ─── Judge Identity ─────────────────────────────────────────────────────────
// A JudgeModel is the stable identity of a judge (e.g. "GPT-4o judge"); each
// JudgeModelVersion is an immutable, independently-calibratable snapshot of
// that judge (weights/quantization/serving backend pinned at that ordinal).
// ModelEndpoint is a user's configured way of reaching a given version.

model JudgeModel {
  id               String              @id @default(cuid())
  name             String
  slug             String              @unique
  judgeClass       JudgeClass
  scoringMechanism ScoringMechanism
  baseModel        String?
  paramsB          Float?
  contextLength    Int?
  trainingRecipe   String? // prompted|sft|dpo|rlvr|mixed
  license          String?
  licenseNote      String?
  modality         String              @default("text")
  taxonomyMode     String? // fixed | policy_conditioned
  streamingCapable Boolean             @default(false)
  retiredAt        DateTime?
  versions         JudgeModelVersion[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model JudgeModelVersion {
  id                     String                     @id @default(cuid())
  judgeModelId           String
  judgeModel             JudgeModel                 @relation(fields: [judgeModelId], references: [id], onDelete: Restrict)
  ordinal                Int
  weightsRevision        String?
  quantization           Quantization               @default(none)
  quantMethod            String?
  servingBackend         ServingBackend
  endpointClass          String?
  trainingDataVintage    DateTime?
  parentVersionId        String?
  parentVersion          JudgeModelVersion?         @relation("VersionLineage", fields: [parentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  successors             JudgeModelVersion[]        @relation("VersionLineage")
  reasoningMode          ReasoningMode              @default(none)
  samplingDefaults       Json?
  protocolSupport        Json // {"pointwise":["score"],"pairwise":["selection"],...}
  supportsRubricAnchored Boolean                    @default(true)
  trustState             TrustState                 @default(untrusted)
  retiredAt              DateTime?
  createdAt              DateTime                   @default(now())
  endpoints              ModelEndpoint[]
  judgments              ModelJudgment[]
  calibrationRuns        CalibrationRun[]
  // Task 12: reverse relations for the evaluation/run model-selection and
  // "best response" identity columns that now point at a version directly.
  evaluationSelections   EvaluationModelSelection[]
  runSelections          RunModelSelection[]
  bestSelections         HumanJudgment[]            @relation("BestJudgeModelVersionSelection")

  @@unique([judgeModelId, ordinal])
}

model ModelEndpoint {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  judgeModelVersionId String
  judgeModelVersion   JudgeModelVersion @relation(fields: [judgeModelVersionId], references: [id], onDelete: Restrict)
  endpoint            String?
  apiKeyEnc           String?
  isActive            Boolean           @default(true)
  verifiedAt          DateTime?
  // Task 12: mirrors the legacy ModelConfig.verificationError field so the
  // /api/models[/[id]]/verify surface (now ModelEndpoint-keyed) can persist
  // and display a human-readable failure reason instead of only clearing
  // verifiedAt. Never set together with a fresh verifiedAt.
  verificationError   String?
  archFingerprint     Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId])
  @@index([judgeModelVersionId])
}

// ─── Prompt Templates ───────────────────────────────────────────────────────
// Versioned judge system-prompt templates. `(name, version)` is the stable
// identity later tasks/importers pin judgments to.

model PromptTemplate {
  id        String          @id @default(cuid())
  name      String
  protocol  RunProtocol
  version   Int
  body      String
  createdAt DateTime        @default(now())
  judgments ModelJudgment[]

  @@unique([name, version])
}

// ─── Evaluation Template ─────────────────────────────────────────────────────
// Stores the immutable input text, title, and default configuration.
// Runs are executed against this template and are tracked separately.

model Evaluation {
  id              String                     @id @default(cuid())
  projectId       String
  project         Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rubricId        String? // default rubric for new runs
  rubric          Rubric?                    @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  inputText       String // legacy single-text artifact (or fallback display text)
  promptText      String? // optional prompt (input) for prompt-response judging
  responseText    String? // optional response/output to evaluate against rubric
  title           String?
  userId          String
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelSelections EvaluationModelSelection[] // default model list for new runs
  runs            EvaluationRun[]

  // ── Dataset link (populated when evaluation was created from a dataset) ──
  datasetId       String?
  dataset         Dataset?       @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  datasetSampleId String?
  datasetSample   DatasetSample? @relation(fields: [datasetSampleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([rubricId])
  @@index([userId])
  @@index([datasetId])
  @@index([datasetSampleId])
}

model EvaluationModelSelection {
  id                  String             @id @default(cuid())
  evaluationId        String
  evaluation          Evaluation         @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  // Task 12: modelConfigId becomes optional — the write path (POST/PATCH
  // /api/evaluations) stops populating it; existing rows keep it. See
  // judgeModelVersionId below, the new selection identity.
  modelConfigId       String?
  modelConfig         ModelConfig?       @relation(fields: [modelConfigId], references: [id], onDelete: Cascade)
  // Task 12: the SOURCE of truth for a selection going forward — set from
  // one of the selecting user's own ModelEndpoints. Nullable only so
  // pre-Task-12 rows (modelConfigId-only) remain valid; every row created
  // by the current write path sets this.
  judgeModelVersionId String?
  judgeModelVersion   JudgeModelVersion? @relation(fields: [judgeModelVersionId], references: [id], onDelete: Restrict)
  createdAt           DateTime           @default(now())

  @@unique([evaluationId, modelConfigId])
  @@unique([evaluationId, judgeModelVersionId])
  @@index([evaluationId])
  @@index([modelConfigId])
  @@index([judgeModelVersionId])
}

// ─── Evaluation Run ───────────────────────────────────────────────────────────
// One discrete execution of an Evaluation template.
// Each press of "Run Models" (or a human-only session) creates one Run.

model EvaluationRun {
  id                 String              @id @default(uuid())
  evaluationId       String
  evaluation         Evaluation          @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  rubricId           String? // rubric version pinned at run time
  rubric             Rubric?             @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  protocol           RunProtocol         @default(pointwise)
  status             RunStatus           @default(pending)
  deadlineAt         DateTime?
  finalizedAt        DateTime?
  triggeredById      String?
  triggeredBy        User?               @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  runModelSelections RunModelSelection[]
  runCandidates      RunCandidate[]
  modelJudgments     ModelJudgment[]
  humanJudgment      HumanJudgment?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  /// A2.1: the golden item this run measured. NULL on every ordinary run.
  /// `Restrict` mirrors `CalibrationRun.goldenSetId` — a measured item must not
  /// vanish out from under the number it produced.
  goldenItemId       String?
  goldenItem         GoldenItem?         @relation("GoldenItemCalibration", fields: [goldenItemId], references: [id], onDelete: Restrict)
  /// A2.1: which calibration this run belongs to. `Restrict` because a
  /// CalibrationRun freezes its golden set irreversibly (`isGoldenSetFrozen`,
  /// src/lib/golden-sets.ts) and there is no unfreeze.
  calibrationRunId   String?
  calibrationRun     CalibrationRun?     @relation(fields: [calibrationRunId], references: [id], onDelete: Restrict)

  /// Idempotency: at most one run per (calibration, item), so a re-launch after
  /// a partial failure resumes instead of double-counting. Both columns are
  /// NULL on every non-calibration run, and Postgres' DEFAULT `NULLS DISTINCT`
  /// lets those coexist freely — so unlike ModelJudgment's index this needs NO
  /// hand-edited SQL.
  @@unique([calibrationRunId, goldenItemId])
  @@index([goldenItemId])
  @@index([evaluationId])
  @@index([rubricId])
  @@index([triggeredById])
  @@index([status])
  @@index([evaluationId, createdAt])
}

// Discrete candidates (pairwise/listwise) generated/scored under a run.
// One row per position in the comparison set (e.g. response A vs B).
model RunCandidate {
  id           String        @id @default(cuid())
  runId        String
  run          EvaluationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  position     Int
  promptText   String?
  responseText String?
  label        String?

  @@unique([runId, position])
}

// Models selected for a specific run (snapshot at run creation time)
model RunModelSelection {
  id                  String             @id @default(cuid())
  runId               String
  run                 EvaluationRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Task 12: optional — see EvaluationModelSelection's identical comment.
  modelConfigId       String?
  modelConfig         ModelConfig?       @relation(fields: [modelConfigId], references: [id], onDelete: Cascade)
  judgeModelVersionId String?
  judgeModelVersion   JudgeModelVersion? @relation(fields: [judgeModelVersionId], references: [id], onDelete: Restrict)
  createdAt           DateTime           @default(now())

  @@unique([runId, modelConfigId])
  @@unique([runId, judgeModelVersionId])
  @@index([runId])
  @@index([modelConfigId])
  @@index([judgeModelVersionId])
}

// ─── Judgments ───────────────────────────────────────────────────────────────

model ModelJudgment {
  id            String        @id @default(cuid())
  runId         String
  run           EvaluationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  modelConfigId String? // nullable (1b): dual-written by web + worker (run-launch.ts, run-create-consumer.ts) alongside judgeModelVersionId until Task 12 retires the ModelConfig write path — see judge-identity.ts's module doc
  modelConfig   ModelConfig?  @relation(fields: [modelConfigId], references: [id], onDelete: Restrict)

  // ── Provenance (which judge, which prompt, pinned at judgment time) ──
  judgeModelVersionId String?
  judgeModelVersion   JudgeModelVersion? @relation(fields: [judgeModelVersionId], references: [id], onDelete: Restrict)
  promptTemplateId    String?
  promptTemplate      PromptTemplate?    @relation(fields: [promptTemplateId], references: [id], onDelete: Restrict)
  samplingParams      Json?
  reasoningEnabled    Boolean?
  pairOrder           String? // e.g. "AB" | "BA" for pairwise position-bias tracking

  // A0 decision #4: what the model SAID, against the pairOrder it was shown
  // ('A' | 'B' | 'tie'). Raw, never normalised — derive, never encode.
  verdict        String?
  overallScore   Float?
  reasoning      String?
  rawResponse    String? // full LLM response, never truncated
  criteriaScores Json? // Array<{ criterionId, criterionName, score, maxScore, weight, comment? }>
  latencyMs      Int?
  tokenCount     Int?
  inputTokens    Int?
  outputTokens   Int?
  servedModelId  String? // model id actually reported by the serving backend
  finishReason   String?
  // 'structured' | 'fallback' | NULL.
  // POINTWISE (src/lib/llm/provider.ts): 'structured' = the strict schema parse
  //   SUCCEEDED on a request that attached a schema; 'fallback' = the lenient
  //   JSON-in-markdown parse (always, when no schema was attached).
  // PAIRWISE (from 2026-09-01, src/lib/llm/registry.ts executePairwiseCall):
  //   'structured' = this request ACTUALLY CARRIED a schema AND
  //   tryParsePairwiseJudgment needed no repair — no markdown fence stripped,
  //   no verdict case/whitespace normalisation; 'fallback' otherwise.
  //   "Carried a schema" is the flag `structuredOutputRequested`, which only
  //   callOpenAICompatible sets, for mode:'judgment' on a descriptor whose
  //   caps.structuredOutput is not 'none' — llamacpp, ollama, vllm. READ THE
  //   FLAG, NOT THE CAPS: anthropic's caps are 'tool_use' (not 'none'), but it
  //   dispatches through callAnthropic, which never attaches a schema and
  //   never sets the flag, so anthropic is always 'fallback' — as are openai
  //   and openrouter, whose caps are 'none'.
  //   CAVEAT when grouping across protocols: pairwise 'structured' is WEAKER
  //   than pointwise 'structured' — extra keys are ignored, so a response with
  //   junk fields that otherwise needed no repair still reads 'structured'.
  // NULL means one of: respond mode (never written); v1 import
  //   (scripts/importer/runs.ts writes null); any error-status row of any
  //   protocol (markJudgmentError never writes it); any pairwise row written
  //   before 2026-09-01, none of which are backfilled — rawResponse is
  //   retained if that is ever wanted. NULL is NOT 'fallback'.
  parseMode      String?

  // ── What the model was ACTUALLY given, and what it ACTUALLY thought ────────
  // Stored, not reconstructed. "Reconstructible from promptTemplateId + the
  // item" is false: PATCH /api/rubrics/[id] deleteMany's the criteria and
  // recreates them on the SAME rubric id with no version bump, and the pairwise
  // system prompt embeds those criteria verbatim — so one rubric edit silently
  // rewrites the reconstruction of every historical judgment, with nothing
  // recording that it moved. GoldenCandidate has no revision trail either.
  /// The model's raw thinking channel, verbatim. NOT merged into `reasoning`:
  /// that field is already triple-booked (parsed pointwise rationale, parsed
  /// pairwise rationale, and the entire generated answer in respond mode), and
  /// the two carry different content — a live Qwen judge returned 762 chars of
  /// deliberation here and `{"verdict":"A"}` in `reasoning`'s source.
  reasoningContent String?
  // usage.completion_tokens_details.reasoning_tokens — USAGE-REPORTED, read in
  // src/lib/llm/openai-compatible.ts only. Populated solely when the server
  // emits the OpenAI usage split. NULL on llama.cpp and on Ollama (measured
  // 2026-08-31 / 2026-09-01, 0/n on every run) and never set by the Anthropic
  // adapter — i.e. NULL on every backend this fleet runs today. Do NOT default
  // it to 0: a real zero and an absent measurement are different facts. For a
  // size signal use `length(reasoningContent)`, and compare the completed
  // rows against the error rows rather than pooling them — that contrast is
  // what identified the 2026-09-01 repetition loop (handoff §5.2: failed mean
  // 44,287 chars vs completed 13,138). scripts/calibration/run.ts prints both
  // populations under "Capture completeness".
  reasoningTokens  Int?
  reasoningSource  String? // 'reasoning_content' | 'reasoning' | 'think_tag' | 'anthropic_thinking'
  systemPrompt     String? // verbatim; small, and its source is MUTABLE (see above)
  userPrompt       String? // verbatim, capped — see promptTruncated
  userPromptSha256 String? // hash of the FULL, pre-truncation user prompt
  promptTruncated  Boolean        @default(false)

  status         JudgmentStatus @default(pending)
  error          String?
  startedAt      DateTime?
  attemptCount   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  @@unique([runId, judgeModelVersionId, pairOrder])
  @@index([runId])
  @@index([modelConfigId])
  @@index([judgeModelVersionId])
  @@index([promptTemplateId])
  @@index([modelConfigId, status])
}

model HumanJudgment {
  id                              String             @id @default(cuid())
  runId                           String             @unique
  run                             EvaluationRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  overallScore                    Float
  reasoning                       String?
  criteriaScores                  Json? // Array<{ criterionId, criterionName, score, maxScore, weight, comment? }>
  // Legacy (pre-Task-12) "best response" pick in respond mode — kept as-is
  // for old rows/deep FK wiring (Task 6 carry, minimized scope per the
  // Task 12 brief: the human-judgment route now prefers
  // selectedBestJudgeModelVersionId below and only falls back to this FK
  // when a legacy modelConfigId-shaped identity is posted).
  selectedBestModelId             String?
  selectedBestModel               ModelConfig?       @relation("BestModelSelection", fields: [selectedBestModelId], references: [id], onDelete: SetNull)
  // Task 12: the version-identity equivalent of selectedBestModelId — set
  // by new respond-mode "best response" picks.
  selectedBestJudgeModelVersionId String?
  selectedBestJudgeModelVersion   JudgeModelVersion? @relation("BestJudgeModelVersionSelection", fields: [selectedBestJudgeModelVersionId], references: [id], onDelete: SetNull)
  userId                          String
  user                            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt

  @@index([userId])
  @@index([selectedBestJudgeModelVersionId])
}

// ─── Developer API Keys ──────────────────────────────────────────────────────
// Fine-grained API keys for programmatic access to the platform.
// Each key is scoped to a user and carries a set of permission scopes.

model DeveloperApiKey {
  id         String    @id @default(cuid())
  name       String // human-readable label, e.g. "CI Pipeline Key"
  prefix     String // first 8 chars of raw key for identification (e.g. "vgk_abc1")
  keyHash    String    @unique // SHA-256 hash of the full key
  scopes     String // JSON array of permission scope strings
  isActive   Boolean   @default(true)
  expiresAt  DateTime? // null = never expires
  lastUsedAt DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([keyHash])
  @@index([prefix])
}

// ─── Datasets ─────────────────────────────────────────────────────────────────
// A dataset is a collection of evaluation samples.
// Can be local (uploaded/inline) or remote (fetched from e.g. HuggingFace).
// Can be private (user-only) or public (visible to all).

model Dataset {
  id          String  @id @default(cuid())
  name        String
  slug        String? // portable identifier for config export/import
  description String?
  source      String     @default("local") // 'local' | 'remote'
  visibility  Visibility @default(private)
  publishedAt DateTime?
  inputType   String     @default("query-response") // 'query' | 'query-response'

  // ── Versioning ──
  version  Int       @default(1)
  parentId String?
  parent   Dataset?  @relation("DatasetVersions", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions Dataset[] @relation("DatasetVersions")

  // ── Remote source fields ──
  sourceUrl      String? // e.g. https://huggingface.co/datasets/livecodebench/code_generation_lite
  huggingFaceId  String? // e.g. livecodebench/code_generation_lite
  remoteMetadata String? // JSON: { description, cardData, splits, features, downloadSize, ... }

  // ── Local / inline data fields ──
  format    String? // 'json' | 'csv' | 'jsonl' | 'text'
  localData String? // JSON string of inline sample data
  filePath  String? // path to uploaded file (if file upload)

  // ── Dataset statistics (populated after fetch or upload) ──
  sampleCount Int? // total number of samples
  splits      String? // JSON: e.g. ["train", "test"]
  features    String? // JSON: column/field schema from HF or inferred
  tags        String? // JSON: array of tag strings

  // ── Relations ──
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  samples     DatasetSample[]
  evaluations Evaluation[]
  goldenSets  GoldenSet[]
  tombstone   Tombstone?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
  @@unique([parentId, version])
  @@index([userId])
  @@index([projectId])
  @@index([parentId])
  @@index([visibility])
  @@index([source])
}

model DatasetSample {
  id        String  @id @default(cuid())
  datasetId String
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  index     Int // ordering within dataset
  input     String // the prompt / question / code to evaluate
  expected  String? // expected output / reference answer (optional)
  metadata  String? // JSON: any extra fields from the source

  evaluations Evaluation[]
  goldenItems GoldenItem[]
  tombstone   Tombstone?
  revisions   SampleRevision[]
  createdAt   DateTime         @default(now())

  @@unique([datasetId, index])
  @@index([datasetId])
}

// ─── Audit Log ──────────────────────────────────────────────────────────────
// Tracks security-critical operations for compliance and debugging.

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. 'user.login', 'apikey.create', 'evaluation.run', 'config.import'
  resource   String? // e.g. 'project', 'evaluation', 'apikey'
  resourceId String? // ID of the affected resource
  metadata   String? // JSON: additional context (old values, new values, etc.)
  ip         String? // client IP address
  userAgent  String? // client user agent
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
}

// ─── Meta-eval (golden sets, calibration) ──────────────────────────────────
// GoldenSet/GoldenItem/GoldenLabel hold expert-labeled ground truth; a
// CalibrationRun measures how well a JudgeModelVersion agrees with those
// labels on a given GoldenSet (kappa/agreement/bias metrics feed the
// TrustState transitions on JudgeModelVersion).

model GoldenSet {
  id              String           @id @default(cuid())
  name            String
  description     String?
  visibility      Visibility       @default(private)
  publishedAt     DateTime?
  // Soft-delete: set instead of hard-deleting a private GoldenSet that a
  // CalibrationRun still references (CalibrationRun.goldenSetId is
  // `onDelete: Restrict` — see src/lib/account-deletion.ts). Row is kept so
  // the calibration history it anchors stays intact; ownerId is left
  // pointing at the (now-deleted) owner and resolves to null via its own
  // `onDelete: SetNull`.
  retiredAt       DateTime?
  // A0: distinct from retiredAt. `retiredAt` = out of circulation but still
  // valid ground truth (a product verb); `tombstonedAt` = pending purge (an
  // account-lifecycle verb). Purge itself is a later wave.
  tombstonedAt    DateTime?

  // ── A0: a golden set is the annotation layer over exactly ONE platform
  // Dataset, imported at exactly ONE protocol. Restrict, so a Dataset with
  // golden sets cannot be deleted. The set is homogeneous: letting its items
  // disagree on protocol would make a single kappa uninterpretable.
  datasetId       String
  dataset         Dataset          @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  protocol        RunProtocol

  // ── Versioning (A0: edit-after-freeze forks) ──
  slug            String?
  version         Int              @default(1)
  parentId        String?
  parent          GoldenSet?       @relation("GoldenSetVersions", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions        GoldenSet[]      @relation("GoldenSetVersions")

  ownerId         String?
  owner           User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  items           GoldenItem[]
  calibrationRuns CalibrationRun[]
  assignments     GoldenAssignment[]

  // ── A1: K, the intervening-items gate for a blind re-read. Lives on the
  // SET so the interval IN FORCE travels with it — a reliability number is
  // uninterpretable without the protocol that produced it, the same reason
  // A0 stores a threshold as data rather than as a constant.
  //
  // ACCEPTED LIMITATION: a set with fewer than K items can never produce a
  // retest, so the queue says so explicitly (`retest-not-yet-eligible` with
  // a shortfall) rather than appearing empty.
  retestIntervalItems Int          @default(20)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([parentId, version])
  // Hand-edited to NULLS NOT DISTINCT in 20260812190000_v2d_golden_substrate —
  // ownerId is nullable (onDelete: SetNull), and Postgres's default NULLS
  // DISTINCT would let two ownerless sets share a slug. Prisma's DSL cannot
  // express the option; the migration's raw SQL is the only record of it.
  // Consequence: at most ONE slug-NULL set per owner. Every A0 write path
  // assigns a slug (generateSlug never returns empty), so this only binds
  // hand-written fixtures — give them slugs.
  @@unique([ownerId, slug])
  @@index([ownerId])
  @@index([parentId])
  @@index([visibility])
  @@index([datasetId])
}

model GoldenItem {
  id                    String            @id @default(cuid())
  goldenSetId           String
  goldenSet             GoldenSet         @relation(fields: [goldenSetId], references: [id], onDelete: Cascade)
  index                 Int
  inputText             String
  promptText            String?
  responseText          String?
  protocol              RunProtocol       @default(pointwise)
  expected              String?
  // ── A0 provenance: which DatasetSample this item was imported from.
  // Restrict, so a sample a golden item annotates cannot be deleted — see
  // the 409 guard on PUT /api/datasets/[id]/samples.
  sourceDatasetSampleId String
  sourceSample          DatasetSample     @relation(fields: [sourceDatasetSampleId], references: [id], onDelete: Restrict)
  labels                GoldenLabel[]
  candidates            GoldenCandidate[]
  revisions             GoldenItemRevision[]
  assignments           GoldenAssignment[]
  // A0 follow-up (owner ruling 2026-08-13): DELETE on an item is a
  // same-transaction tombstone tag, never a row removal. NULL = live. The
  // row KEEPS its `index` — @@unique([goldenSetId, index]) below is
  // deliberately NOT partial, so a tombstoned ordinal stays taken and
  // survivors are never re-packed. See nextGoldenItemIndex in
  // src/lib/golden-sets.ts for what the next index is.
  tombstonedAt          DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([goldenSetId, index])
  // Serves the filtered COUNT on every paginated items read and every
  // `_count.items` on the list page. The ordered read still comes off
  // GoldenItem_goldenSetId_index_key.
  @@index([goldenSetId, tombstonedAt])
  @@index([sourceDatasetSampleId])
  /// A2.1: calibration runs that measured this item.
  calibrationEvaluationRuns EvaluationRun[] @relation("GoldenItemCalibration")
}

// Discrete candidates (pairwise/listwise) attached to a golden item.
// RunCandidate (schema.prisma:417-427) field-for-field, different parent:
// the team already accepted this shape once, and A2 compares a golden item's
// candidates against a run's candidates.
model GoldenCandidate {
  id           String     @id @default(cuid())
  goldenItemId String
  goldenItem   GoldenItem @relation(fields: [goldenItemId], references: [id], onDelete: Cascade)
  position     Int
  promptText   String?
  responseText String?
  label        String?

  @@unique([goldenItemId, position])
}

model GoldenLabel {
  id               String     @id @default(cuid())
  goldenItemId     String
  goldenItem       GoldenItem @relation(fields: [goldenItemId], references: [id], onDelete: Cascade)
  annotatorId      String?
  annotator        User?      @relation(fields: [annotatorId], references: [id], onDelete: SetNull)

  // ── A1: a pointwise label is a SCORE, a pairwise label is a PREFERENCE.
  // `overallScore` became nullable here and `preference` was added beside
  // it, under the hand-written CHECK
  // `GoldenLabel_score_xor_preference` (num_nonnulls(...) = 1) in
  // 20260818120000_v2h_human_verification — Prisma's DSL has no CHECK
  // syntax of any kind, so this file can only say that both are optional,
  // and "exactly one" is invisible here. See CONTRIBUTING.md's "Known
  // migrate-diff pseudo-drift" table. Encoding a preference as a float was
  // rejected: the stored number would be uninterpretable without an
  // out-of-band convention. `preference` uses GoldenItem.expected's
  // vocabulary ('A>B' | 'B>A' | 'tie') so a label and its ground truth
  // compare directly.
  overallScore     Float?
  preference       String?

  // ── A1 test-retest: WHICH BLIND READING this is. Two readings by one
  // annotator on one item are PEERS, not a tombstone and a survivor —
  // tombstoning the first would overload "retracted" with "an earlier valid
  // reading", and every live-label query (the agreement maths included)
  // would silently drop it. The partial unique index therefore widened to
  // (goldenItemId, annotatorId, round) in v2h; see the comment below.
  //
  // THE SERVER DECIDES THIS, never the client — a client-named round makes
  // blinding client-trusted, and a stale tab defeats the reliability signal
  // the column exists to produce.
  round            Int        @default(1)

  // ── A1 provenance: the item content THIS annotator saw.
  //
  // NULL means they saw the item's CURRENT content. Non-null means they saw
  // that revision's BEFORE-IMAGE. It is written by the EDIT, not by the
  // label: with before-image semantics the revision capturing what an
  // annotator saw does not exist until the edit that supersedes it, so the
  // same `updateMany` in PATCH /api/golden-sets/[id]/items that tombstones
  // these labels also stamps them with the revision it just wrote — those
  // are exactly the labels that saw it.
  goldenItemRevisionId String?
  goldenItemRevision   GoldenItemRevision? @relation(fields: [goldenItemRevisionId], references: [id], onDelete: SetNull)

  criteriaScores   Json?
  reasoning        String?
  // A human label is the expensive, irreplaceable artifact this roadmap
  // exists to protect, so PATCH /api/golden-sets/[id]/items TOMBSTONES the
  // labels of an item whose content changed rather than deleting them
  // (owner ruling 2026-08-13, extended to labels — see that handler's doc).
  // `tombstonedReason` records WHY: 'item-content-edit' is the only writer
  // today; a future retraction or purge gets its own value rather than
  // overloading this one.
  tombstonedAt     DateTime?
  tombstonedReason String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // `@@unique([goldenItemId, annotatorId])` IS GONE ON PURPOSE. It is
  // replaced by a PARTIAL unique index restricted to WHERE "tombstonedAt"
  // IS NULL, hand-written in
  // 20260813120000_v2e_golden_item_label_tombstones — and WIDENED by
  // 20260818120000_v2h_human_verification, which drops that index and
  // recreates it as
  // GoldenLabel_goldenItemId_annotatorId_round_live_key over
  // (goldenItemId, annotatorId, round). Test-retest needs TWO live readings
  // by one annotator on one item; the two-column version permitted one.
  // Everything below still applies, one column wider. Prisma's DSL has no
  // syntax for a WHERE predicate, so this file cannot declare it and the
  // migration's raw SQL is the only record. Whole-table uniqueness would let
  // a tombstoned label occupy its annotator's slot forever, making
  // re-annotation after an edit impossible. See CONTRIBUTING.md's "Known
  // migrate-diff pseudo-drift" table.
  //
  // The index below is NOT redundant: dropping the unique also dropped the
  // only btree serving `where: { goldenItemId }`, and the partial one covers
  // live rows only.
  @@index([goldenItemId])
  @@index([annotatorId])
}

model CalibrationRun {
  id                  String            @id @default(cuid())
  judgeModelVersionId String
  judgeModelVersion   JudgeModelVersion @relation(fields: [judgeModelVersionId], references: [id], onDelete: Restrict)
  goldenSetId         String
  goldenSet           GoldenSet         @relation(fields: [goldenSetId], references: [id], onDelete: Restrict)
  kappa               Float?
  rawAgreement        Float?
  /// The constant-verdict floor beside the number it floors (v2l): the hit
  /// rate of a judge stamping the answer key's plurality class on every
  /// SCORED item — max(key class)/verdictCount over the scored subset, never
  /// over the whole set (run 9 scored 25 of 30 keyed 14/11: 0.5600, not the
  /// full key's 0.5667). Written by score.ts in the same full-overwrite update
  /// as rawAgreement so re-scoring after a drain moves both together; the pure
  /// function in src/lib/calibration/baseline.ts is the source of truth and
  /// this is its stored copy for readers that never load the module (the
  /// handoff §8 scoreboard SQL). NULL means "not scored since v2l" — the 9
  /// production rows stay NULL until each is re-scored with --score-only.
  constantBaselineAccuracy Float?
  /// Which generation of the SCORING RULES produced every scored field on this
  /// row (v2m). Scoring is ex post — a score is a pure function over stored
  /// judgments and `--score-only` re-derives it without executing a model — so
  /// the rules can improve while the data does not, and two rows scored under
  /// different generations on one scoreboard compare two different questions.
  /// `src/lib/calibration/scoring-version.ts` is the source of truth
  /// (SCORING_RULES_VERSION + its changelog); score.ts stamps it in the same
  /// full-overwrite update as rawAgreement, so the numbers and the stamp cannot
  /// move independently. NULL means exactly one thing: "scored before v2m, rule
  /// generation unrecorded". It is NOT 0 and NOT version 1 — all 20 production
  /// rows read NULL until each is re-scored. A scoreboard query FILTERS on an
  /// explicit version and never COALESCEs this column.
  scoringVersion      Int?
  /// Items this judge COMMITTED on — a raw verdict other than 'tie' (v2n). The
  /// denominator of `selectiveAccuracy`, and the numerator of coverage, which is
  /// `committedCount::float / NULLIF("verdictCount", 0)` and is deliberately NOT
  /// stored: both operands are on this row, and a derived duplicate drifts when
  /// a re-score moves verdictCount. The NULLIF is load-bearing, not decoration:
  /// a scored-but-empty run is real (production row cmton7ip500012lyjubiqohy8),
  /// and unguarded the division RAISES division_by_zero rather than yielding
  /// NULL — while the NULL the guard does yield is the correct "no coverage to
  /// report", so never COALESCE it to 0. NULL means "not scored since v2n",
  /// never "committed to nothing" — that case is committedCount = 0 with
  /// selectiveAccuracy NULL.
  committedCount      Int?
  /// How often the judge was right WHEN IT ANSWERED: correct-among-committed /
  /// committedCount (v2n). The golden key is forced choice (336 'A>B' / 284
  /// 'B>A', no ties), so a 'tie' can never be correct and `rawAgreement`
  /// multiplies two independent quantities — how often the judge commits, and
  /// how often it is right when it does. Measured 2026-09-06: lfm2.5:8b and
  /// lfm2.5-thinking differ 5.3x on rawAgreement (0.0929 vs 0.4887) and are
  /// indistinguishable on this column (0.5437 vs 0.5363). NULL at ZERO coverage
  /// — never 0, never 1, never NaN — because "it was never right when it
  /// answered" is a measurement and "it never answered" is not.
  selectiveAccuracy   Float?
  /// The constant-verdict floor over the COMMITTED SUBSET (v2n) — max(key
  /// class)/committedCount, the floor `selectiveAccuracy` must clear. NOT
  /// `constantBaselineAccuracy`, which is over every scored item: comparing
  /// selective accuracy against THAT is precisely the error v2l exists to
  /// prevent, one level down, and on production data it flips the margin's sign
  /// for two of four judges (lfm2.5-thinking 0.5363 selective is +0.0071 over
  /// its committed floor of 0.5292 and -0.0056 against the full 0.5419).
  /// src/lib/calibration/baseline.ts is the source of truth; this is its stored
  /// copy for readers that never load the module.
  selectiveBaselineAccuracy Float?
  testRetest          Float?
  /// v2o. |(verdicts naming slot A across BOTH orders) / 2n - 0.5|, computed
  /// on the RAW verdict letter BEFORE preferenceFromVerdict — which is what
  /// makes it independent of the answer key's class balance. 0.5 = every
  /// verdict named the first slot; 0.0 = no net side. NULL means no paired
  /// decisive item existed; read `ordersRequested` to tell "never paired"
  /// from "paired but undecisive".
  positionBias        Float?
  /// v2o. Fraction of paired decisive items whose PREFERENCE changed under
  /// swap. Its no-information point is 0.5, not 0: any order-independent
  /// judge flips at least half the time. Stored beside positionBias because
  /// a symmetric flipper scores 0.0 there and 1.0 here.
  orderFlipRate       Float?
  /// v2o. The denominator BOTH estimators share — items decisive in both
  /// orders. Never render either rate without it.
  pairedDecisiveCount Int?
  /// v2o. Which orders this run ASKED for. COMMA-SEPARATED, written by
  /// `src/lib/calibration/launch.ts` as `orders.join(',')` — e.g. 'AB' for an
  /// unpaired run, 'AB,BA' for a paired one. THIS IS NOT AN ENUM: test
  /// membership with `.includes('BA')`, never `=== 'BA'` — a later reader
  /// comparing `ordersRequested === 'AB'` would read a paired run's 'AB,BA'
  /// as unpaired and silently misclassify it. Without this column a BA half
  /// that launched and never drained would store identically to a run that
  /// never had one, and a NULL estimator would be ambiguous.
  ordersRequested     String?
  biasSensitivityRate Float?
  flipRateVsParent    Float?
  /// The rubric in force for this calibration. The pairwise SYSTEM prompt
  /// renders the rubric's criteria, so a kappa produced under rubric X is not
  /// comparable to one under rubric Y — and without this the leaderboard header
  /// cannot say which it used.
  rubricId            String?
  rubric              Rubric?           @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  /// The EFFECTIVE sampling params this calibration was LAUNCHED under:
  /// `effectiveSamplingParams(JudgeModelVersion.samplingDefaults)` resolved
  /// inside the launch transaction (src/lib/calibration/launch.ts) — a fully
  /// populated `{ temperature, max_tokens }`, never the raw, nullable, possibly
  /// partial `samplingDefaults`. Same shape and meaning as
  /// `ModelJudgment.samplingParams`, which every judgment of this run should
  /// equal; a judgment that differs means the version row was edited mid-run
  /// (scoreboard spec §4.1; runbook §8.8). Pinned for the same reason
  /// `rubricId` is: `samplingDefaults` is MUTABLE — three writers
  /// (scripts/admin/add-judge.ts, scripts/importer/judges.ts,
  /// prisma/seed-core.ts), no history — so a join through the version reports
  /// TODAY's config for a historical run, even though prisma/seed-core.ts:223-229
  /// declares a version immutable under a judgment ("a version that needs
  /// different values is a new ordinal"). The production 4096 -> 12288 edits
  /// broke that invariant; this column is the defence. NULL means exactly one
  /// thing: launched before v2k (9 production rows; no backfill).
  samplingParams      Json?
  evaluationRuns      EvaluationRun[]
  verdictCount        Int               @default(0)
  passed              Boolean?
  // A0 decision #3: `passed` alone is uninterpretable a year later — record
  // the threshold that was in force and what it was applied to.
  passThreshold       Float?
  thresholdMetric     String?
  kappaVariant        String? // 'cohen' | 'fleiss'
  kappaWeighting      String? // 'linear' | 'quadratic'
  startedAt           DateTime          @default(now())
  finishedAt          DateTime?

  @@index([judgeModelVersionId])
  @@index([goldenSetId])
}

// ─── The tombstone overlay (A1) ─────────────────────────────────────────────
// One row per HIDDEN entity. "No row" means live, so this table is empty until
// something is deleted. Adopted by both Dataset and DatasetSample; a sample
// inherits its parent dataset's hidden state through the read filter in
// src/lib/tombstones.ts, never through a second row here.
//
// Deliberately NOT A0's `tombstonedAt` column form (GoldenSet, GoldenItem,
// GoldenLabel). Those are one-way on purpose: goldenSetLifecycleWhere pins
// `tombstonedAt: null` in BOTH arms so a tombstoned set has no way back. This
// overlay is REVERSIBLE — un-hiding flips the flag rather than deleting the
// row, so createdAt/updatedAt still record that the entity was once hidden.
// Two mechanisms with different capabilities, coexisting on purpose. Do not
// harmonise them.

model Tombstone {
  id String @id @default(cuid())

  // Exactly one of these is non-null. That is a REAL constraint, not a
  // comment: `Tombstone_exactly_one_entity`, a CHECK hand-edited into
  // 20260814120000_v2f_tombstone_overlay because Prisma's DSL cannot express
  // a CHECK at all. Without it Postgres accepts both-null orphans (a
  // tombstone hiding nothing) and both-set rows (one row claiming to hide a
  // dataset AND a sample), because a unique index permits unlimited NULLs.
  // See CONTRIBUTING.md's "Known migrate-diff pseudo-drift" table.
  //
  // Each FK is @unique so the relation is to-ONE. That is what makes `upsert`
  // correct and what makes `{ tombstone: { is: ... } }` match at most one row
  // per entity. No @@index on either column: @unique already creates one.
  //
  // No @relation("name") on either side. Prisma demands a named relation only
  // when TWO relations connect the SAME PAIR of models; these connect
  // Tombstone↔DatasetSample and Tombstone↔Dataset — different pairs — so the
  // disambiguation is not required and adding it would only add a name to
  // keep in sync. Confirmed with `prisma validate` before landing.
  datasetSampleId String?        @unique
  datasetSample   DatasetSample? @relation(fields: [datasetSampleId], references: [id], onDelete: Cascade)
  datasetId       String?        @unique
  dataset         Dataset?       @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  // Defaults to true because the only code that INSERTs here is a delete; a
  // restore UPDATEs an existing row rather than creating one.
  isTombstone Boolean @default(true)
  reason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── The revision log (L2) ──────────────────────────────────────────────────
// Append-only. One row per mutation to a DatasetSample, carrying the values as
// they stood BEFORE the change.
//
// Deliberately separate from Tombstone, and the two are not merge-able:
// Tombstone is the CURRENT-STATE projection the read filters consult and needs
// @unique per entity to be a to-one relation and to make upsert correct; a log
// needs MANY rows per entity and therefore cannot carry that uniqueness.
//
// Nothing filters this table by the overlay. The history of a HIDDEN sample is
// exactly what you read when deciding whether to restore it.

model SampleRevision {
  id String @id @default(cuid())

  datasetSampleId String
  datasetSample   DatasetSample @relation(fields: [datasetSampleId], references: [id], onDelete: Cascade)

  // 'edit' | 'delete' | 'restore'. A String rather than an enum, matching
  // GoldenLabel.tombstonedReason and Dataset.source — this schema uses enums
  // only where Prisma already had one (Visibility, RunProtocol).
  changeType String

  // The values BEFORE the change. Null on 'delete' and 'restore', which change
  // no content, so a before-image would be a copy of the live row.
  input    String?
  expected String?
  metadata String?

  // SetNull, matching GoldenLabel.annotatorId: account deletion anonymises
  // rather than destroying. There is deliberately NO unique constraint on this
  // table, so two deleted actors coexist freely on one sample's history.
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  at DateTime @default(now())

  // Serves the only query: one sample's history, newest first.
  @@index([datasetSampleId, at])
}

// ─── A1: human verification ─────────────────────────────────────────────────

// SampleRevision's shape one level up, at the level labelling actually
// happens. Append-only, one row per content edit, carrying the values as they
// stood BEFORE the change.
//
// Written by PATCH /api/golden-sets/[id]/items INSIDE the transaction that
// already tombstones the item's labels — not beside it, so a rolled-back edit
// leaves no revision claiming it happened.
model GoldenItemRevision {
  id           String     @id @default(cuid())
  goldenItemId String
  goldenItem   GoldenItem @relation(fields: [goldenItemId], references: [id], onDelete: Cascade)

  // The before-image. Exactly the four fields the items PATCH already reads to
  // detect a change and, before A1, threw away.
  inputText    String
  promptText   String?
  responseText String?
  expected     String?

  // SetNull, matching GoldenLabel.annotatorId and SampleRevision.actorId:
  // account deletion anonymises rather than destroying.
  actorId String?
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  at      DateTime @default(now())

  labels GoldenLabel[]

  // Serves the only query: one item's history, newest first.
  @@index([goldenItemId, at])
}

// WHO WAS ASKED to annotate WHAT. Explicit rows rather than self-selection,
// because inter-annotator agreement requires OVERLAP — the same items read by
// more than one annotator. Without assignment the overlap is whatever
// coincides, easy items get their second reading first, and the resulting
// kappa is optimistic in a way nothing in the system can detect.
model GoldenAssignment {
  id          String    @id @default(cuid())
  goldenSetId String
  goldenSet   GoldenSet @relation(fields: [goldenSetId], references: [id], onDelete: Cascade)

  // SetNull to match GoldenLabel.annotatorId: an assignment to a deleted
  // account is a record of what was ASKED, not something to be actioned.
  annotatorId String?
  annotator   User?   @relation("AssignedAnnotator", fields: [annotatorId], references: [id], onDelete: SetNull)

  // NULL = the whole set. Set = one item, for adjudication or a targeted
  // re-read. Both granularities, because assigning 620 rows individually is
  // the exception and not the normal case.
  goldenItemId String?
  goldenItem   GoldenItem? @relation(fields: [goldenItemId], references: [id], onDelete: Cascade)

  round Int @default(1)

  assignedById String?
  assignedBy   User?    @relation("AssigningCoordinator", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt   DateTime @default(now())
  completedAt  DateTime?

  // DELETE on this resource REVOKES rather than removing the row. A partial
  // unique index (hand-written in v2h, WHERE "revokedAt" IS NULL) keeps one
  // ACTIVE assignment per (item, annotator, round) while letting a revoked
  // one be superseded — Prisma's DSL cannot express the predicate, so it is
  // invisible in this file. See CONTRIBUTING.md's pseudo-drift table.
  revokedAt     DateTime?
  revokedReason String?

  @@index([goldenSetId, annotatorId])
  @@index([annotatorId, revokedAt])
}

/// A2.1 / queue lanes: the permanent lane assignment for one SERIALIZATION
/// DOMAIN — a normalized inference-server origin such as
/// `http://192.168.1.9:11434`, or `version:<judgeModelVersionId>` for a judge
/// with no endpoint URL (an elastic hosted API, which is rate-limited rather
/// than slot-limited and needs no server-level serialization).
///
/// WHY A TABLE AND NOT A HASH. The obvious design routes by a consistent hash
/// of the key into N shards. It has a birthday problem: at two distinct
/// origins and 32 shards there is a ~3% chance both land on one shard, and
/// the entire change then ships and does nothing — silently, permanently, and
/// undetectably from shard depth alone. The key space here is tiny and
/// slow-moving (2 servers today, perhaps 10 in a year), so assignment can
/// simply be recorded instead of computed.
///
/// Three properties that follow, none of which hashing has:
///   - ZERO collisions for the first LANE_COUNT origins. Not usually — always.
///   - Growing LANE_COUNT is nearly free: `(id-1) % 8 == (id-1) % 32` for
///     id <= 8, so existing origins keep their exact lane and only new ones
///     move. A consistent hash reshuffles a fraction of ALL keys.
///   - `SELECT * FROM "QueueLane"` answers "what is on lane 5" and "who is
///     starved". Shard depth cannot.
///
/// `id` is the assignment ORDER and is load-bearing — the lane is derived from
/// it. Rows are never deleted: a deletion would renumber nothing (ids are not
/// reused) but would let a live origin be re-assigned to a different lane
/// while messages for it are still queued on the old one.
model QueueLane {
  id        Int      @id @default(autoincrement())
  /// Normalized origin (scheme://host:port, lowercased, explicit port, no
  /// path) or `version:<id>`. Unique because the assignment must be stable.
  laneKey   String   @unique
  createdAt DateTime @default(now())
}
